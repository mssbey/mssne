generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         String     @default("VIEWER")
  active       Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  sessions     Session[]
  auditLogs    AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model SiteSetting {
  id        String   @id @default("main")
  brand     Json
  contact   Json
  social    Json
  seo       Json
  theme     Json
  scripts   Json
  updatedAt DateTime @updatedAt
}

model Page {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  excerpt        String?
  content        String        @default("")
  coverImage     String?
  template       String        @default("DEFAULT")
  status         String        @default("DRAFT")
  showInMenu     Boolean       @default(false)
  showInFooter   Boolean       @default(false)
  sortOrder      Int           @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  sections       PageSection[]

  @@index([status, sortOrder])
}

model PageSection {
  id        String   @id @default(cuid())
  pageId    String
  type      String
  name      String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder])
}

model Service {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  shortDescription String?
  content          Json
  coverImage       String?
  icon             String?
  status           String    @default("DRAFT")
  active           Boolean   @default(true)
  featured         Boolean   @default(false)
  showOnHome       Boolean   @default(false)
  sortOrder        Int       @default(0)
  viewCount        Int       @default(0)
  publishedAt      DateTime?
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  ogImage          String?
  canonicalUrl     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([status, sortOrder])
}

model ProjectCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  projects  Project[]
}

model Project {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  clientName       String?
  shortDescription String?
  content          Json
  coverImage       String?
  videoUrl         String?
  location         String?
  projectDate      DateTime?
  externalUrl      String?
  status           String           @default("DRAFT")
  active           Boolean          @default(true)
  featured         Boolean          @default(false)
  showOnHome       Boolean          @default(false)
  sortOrder        Int              @default(0)
  viewCount        Int              @default(0)
  seoTitle         String?
  seoDescription   String?
  ogImage          String?
  categoryId       String?
  category         ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images           ProjectImage[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  @@index([status, sortOrder])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Reference {
  id         String    @id @default(cuid())
  company    String
  logo       String?
  website    String?
  active     Boolean   @default(true)
  showOnHome Boolean   @default(true)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

model Testimonial {
  id        String    @id @default(cuid())
  name      String
  company   String?
  position  String?
  comment   String
  image     String?
  rating    Int       @default(5)
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Media {
  id           String    @id @default(cuid())
  filename     String
  originalName String
  url          String    @unique
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  title        String?
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([mimeType, createdAt])
}

model PromotionCategory {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  description String?
  image       String?
  icon        String?
  color       String             @default("#EC4899")
  active      Boolean            @default(true)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  products    PromotionProduct[]

  @@index([active, sortOrder])
}

model PromotionProduct {
  id          String             @id @default(cuid())
  categoryId  String
  name        String
  slug        String             @unique
  description String
  features    Json
  minQty      Int                @default(1)
  image       String?
  status      String             @default("DRAFT")
  active      Boolean            @default(true)
  featured    Boolean            @default(false)
  sortOrder   Int                @default(0)
  seoTitle    String?
  seoDescription String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  category    PromotionCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  images      PromotionImage[]

  @@index([categoryId, status, sortOrder])
}

model PromotionImage {
  id        String           @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int              @default(0)
  product   PromotionProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Menu {
  id        String     @id @default(cuid())
  name      String
  location  String     @unique
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id          String     @id @default(cuid())
  menuId      String
  parentId    String?
  label       String
  url         String
  icon        String?
  targetBlank Boolean    @default(false)
  active      Boolean    @default(true)
  desktop     Boolean    @default(true)
  mobile      Boolean    @default(true)
  sortOrder   Int        @default(0)
  menu        Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent      MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    MenuItem[] @relation("MenuTree")

  @@index([menuId, parentId, sortOrder])
}

model ContactSubmission {
  id          String        @id @default(cuid())
  name        String
  phone       String?
  email       String
  company     String?
  service     String?
  subject     String?
  message     String
  kvkkConsent Boolean
  status      String        @default("NEW")
  ip          String?
  sourcePage  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  notes       ContactNote[]

  @@index([status, createdAt])
}

model ContactNote {
  id           String            @id @default(cuid())
  submissionId String
  note         String
  createdAt    DateTime          @default(now())
  submission   ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  module    String
  recordId  String?
  oldData   Json?
  newData   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([module, recordId])
}
